# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EXCHANGE_RATE_API_URL: Optional endpoint returning AED->INR rate (defaults to open.er-api.com v6 AED feed)
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/AED"

# EXCHANGE_RATE_API_KEY: Optional API key if using a paid exchange-rate provider
EXCHANGE_RATE_API_KEY=""

# SESSION_SECRET: HMAC signing secret for WebX staff/admin credentials sessions (falls back to runtime random secret if unset)
SESSION_SECRET=""

# ADMIN_OWNER_EMAIL: Optional email automatically assigned ADMIN role on Google Sign-In
ADMIN_OWNER_EMAIL=""

# SUPPORT_EMAIL: Official WebX Support Desk recipient address
SUPPORT_EMAIL="adwebcomicllp@gmail.com"

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM: Optional SMTP credentials for automated email dispatch to adwebcomicllp@gmail.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
